<script>
  document.addEventListener('astro:page-load',(e)=>{
    console.log('Page loaded')
  })
  const circleControl = document.getElementsByClassName('circle-control')
  let isDragging = false
  for(let circle of circleControl){
    // circle.addEventListener('mousedown',e=>{
    //   if(e.target instanceof HTMLElement){
    //     e.target.classList.add('cursor-grabbing')
    //     e.target.classList.remove('cursor-grab')
    //   }
    // })
    
    circle.addEventListener('mouseup',e=>{
      // isDragging = false
      if(e.target instanceof HTMLElement){
        e.target.classList.add('cursor-grab')
        e.target.classList.remove('cursor-grabbing')
      }
    })
    circle.addEventListener('mousedown',e=>{
      // isDragging = true
      if(e.target instanceof HTMLElement){
        e.target.classList.add('cursor-grabbing')
        e.target.classList.remove('cursor-grab')
      }
    })
    circle.parentElement.addEventListener('mouseup',e=>{
      isDragging = false
    })
    circle.parentElement.addEventListener('mousedown',e=>{
      isDragging = true
    })
    circle.parentElement.addEventListener('mousemove',e=>{
      // console.log('Dentro del mousemove')
      if (!isDragging) return
      
      const x = e.offsetX
      const y = e.offsetY
      console.log('Posición del mouse: ',x,y)
      if(e.target instanceof HTMLElement){
        // const circleRect = circle.getBoundingClientRect()
        // console.log('Posición del círculo: ',circleRect.x,circleRect.y)
        // let p = 122.5 + y
        // console.log('Valor de p: ',p)
        circle.style.transform = `translateY(${y}px)`
      }
    })
